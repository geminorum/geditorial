#: ModuleSettings.php:19
msgctxt "Card Title"
msgid "Attribute to Unique-ID"
msgstr "ویژگی به شناسه یکتا"

#: ModuleSettings.php:22
msgctxt "Button"
msgid "Migrate Data"
msgstr "انتقال داده‌ها"

#: ModuleSettings.php:28
msgctxt "Message"
msgid "Imports Unique-ID product attributes into built-in global unique ID fields."
msgstr "ویژگی‌های شناسه یکتا کالا را در زمینه‌های شناسه یکتای جهانی درون‌ریزی می‌کند."

#. translators: `%1$s`: unique-id placeholder, `%2$s`: product title
#: ModuleSettings.php:70
#, php-format
msgctxt "Notice"
msgid "%1$s Unique-ID already saved for &ldquo;%2$s&rdquo;."
msgstr "شناسه %1$s پیش از این &rdquo;%2$s&ldquo; برای ذخیره شده است."

#. translators: `%1$s`: unique-id placeholder, `%2$s`: attribute name, `%3$s`: product title
#: ModuleSettings.php:88
#, php-format
msgctxt "Notice"
msgid "%1$s Unique-ID migrated from &ldquo;%2$s&rdquo; attribute for &ldquo;%3$s&rdquo;. The attribute has more than one option!"
msgstr "شناسه %1$s از ویژگی &rdquo;%2$s&ldquo; برای &rdquo;%3$s&ldquo; منتقل شد. این ویژگی شامل بیش از یک گزینه است!"

#. translators: `%1$s`: unique-id placeholder, `%2$s`: attribute name, `%3$s`: product title
#: ModuleSettings.php:102
#, php-format
msgctxt "Notice"
msgid "%1$s Unique-ID migrated from &ldquo;%2$s&rdquo; attribute for &ldquo;%3$s&rdquo;. The attribute successfully deleted!"
msgstr "شناسه %1$s از ویژگی &rdquo;%2$s&ldquo; برای &rdquo;%3$s&ldquo; منتقل شد. این ویژگی با موفقیت حذف شد!"

#. translators: `%s`: product title
#: ModuleSettings.php:111
#, php-format
msgctxt "Notice"
msgid "No relevant Unique-ID attribute found for &ldquo;%s&rdquo;."
msgstr "هیچ ویژگی شناسه یکتای مناسبی برای &rdquo;%s&ldquo; پیدا نشد."

#: WcIdentify.php:51
msgctxt "Setting Title"
msgid "Display Unique-ID"
msgstr "نمایش شناسه یکتا"

#: WcIdentify.php:52
msgctxt "Setting Description"
msgid "Prepends the global unique id on product attributes table."
msgstr "شناسه یکتای جهانی را به ابتدای جدول ویژگی‌های کالا اضافه می‌کند."

#: WcIdentify.php:56
msgctxt "Setting Title"
msgid "Unique-ID lookup"
msgstr "جست‌وجوی شناسه یکتا"

#: WcIdentify.php:57
msgctxt "Setting Description"
msgid "Makes the value for the global unique id clickable on product attributes table."
msgstr "امکان کلیک مقدار شناسه یکتای جهانی را در جدول ویژگی‌های کالا اضافه می‌کند."

#: WcIdentify.php:62
msgctxt "Setting Title"
msgid "Unique-ID Label"
msgstr "شاخص شناسه یکتا"

#: WcIdentify.php:63
msgctxt "Setting Description"
msgid "Overrides the default label for the global unique-id on product attributes table."
msgstr "شاخص پیش‌فرض شناسه یکتای جهانی را در جدول ویژگی‌های کالا رونویسی می‌کند."

#: WcIdentify.php:64 WcIdentify.php:113
msgctxt "Attribute Label"
msgid "Unique-ID"
msgstr "شناسه یکتا"

#: WcIdentify.php:71
msgctxt "Setting Title"
msgid "Display on Order Details"
msgstr "نمایش در جزئیات سفارش"

#: WcIdentify.php:72
msgctxt "Setting Description"
msgid "Appends the global unique-id on order details and preview."
msgstr "شناسه یکتای جهانی را به ابتدای جدول ویژگی‌های کالا اضافه می‌کند."

#: WcIdentify.php:76
msgctxt "Setting Title"
msgid "Unique-ID Exemptions"
msgstr "معافیت‌های شناسه یکتا"

#: WcIdentify.php:77
msgctxt "Setting Description"
msgid "Instructs output structured data that a valid identifier for the product doesn't exist."
msgstr "داده‌های ساختاریافته خروجی را برای عدم وجود شناسه معتبر کالا، راهنمایی می‌کند."

#: WcIdentify.php:140
msgctxt "Notice"
msgid "Click to Copy"
msgstr "کلیک برای کپی"

#: WcIdentify.php:324
msgctxt "Header"
msgid "Product Identification Tools"
msgstr "ابزارهای شناسایی کالا"

